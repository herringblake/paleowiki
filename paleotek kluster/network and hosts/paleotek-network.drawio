<mxfile host="app.diagrams.net"><diagram id="net" name="Paleotek network"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="net" value="Internet" style="rounded=1;whiteSpace=wrap;html=1;shape=cloud;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="960" y="10" width="240" height="70" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;Outside services&lt;/b&gt;&lt;br&gt;GitHub (Flux, paleowiki, CI) · Let's Encrypt (HTTP-01)&lt;br&gt;FreeDNS (follows the public IP) · SMTP relay (alert mail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="10" width="440" height="80" as="geometry"/></mxCell><mxCell id="rtr" value="&lt;b&gt;Router madhatter&lt;/b&gt; 10.0.0.1&lt;br&gt;DHCP .20-.199 · forwards 80 and 443 to .200&lt;br&gt;public IP changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="130" width="300" height="70" as="geometry"/></mxCell><mxCell id="lan" value="LAN 10.0.0.0/24 · domain home.arpa" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;arcSize=2;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1240" height="900" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;LAN clients&lt;/b&gt;&lt;br&gt;browsers, kubectl, ssh&lt;br&gt;trust the internal root CA&lt;br&gt;kubectl reaches the API on :6443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lan"><mxGeometry x="20" y="100" width="230" height="90" as="geometry"/></mxCell><mxCell id="pihole" value="&lt;b&gt;Pi-hole&lt;/b&gt; 10.0.0.2&lt;br&gt;primary DN